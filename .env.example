# ---------------------------------------------------------------------------
# CUEC API server (Express). Copy these keys into the project's `.env.local`;
# both Next.js and the API read the same file.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
API_PORT=4000

# MongoDB (shared with the Next app, database name defaults to CUEC).
# NOT USABLE AS-IS: replace the user, password AND host. Atlas → Connect →
# Drivers gives you something like
#   mongodb+srv://<user>:<password>@cluster0.znex6tg.mongodb.net/?retryWrites=true&w=majority
# "cluster.mongodb.net" is only a sample; a real host has a generated subdomain.
MONGODB_URI=""
MONGO_DB_NAME=CUEC

# Public client key. It is shipped to the browser through NEXT_PUBLIC_API_KEY,
# so treat it as an abuse filter, not a secret. Minimum 16 characters.
API_KEY="_c9fvUiEW0C16S0esO8mOLJyUmGJxBAj"

# The same value must be set as NEXT_PUBLIC_API_KEY in the frontend env file.
NEXT_PUBLIC_API_KEY="_c9fvUiEW0C16S0esO8mOLJyUmGJxBAj"

# Where the frontend lives; used for CORS and mutation origin checks.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

# Secret that signs the short-lived admin tokens the Next app mints for
# signed-in admins. 32+ chars. NEVER expose it to the browser.
ADMIN_TOKEN_SECRET="replace-with-a-32-byte-random-secret"

# Optional server-to-server key for scripts/migration (bypasses admin tokens).
SERVICE_API_KEY=""

# Optional transactional email (registration receipts).
RESEND_API_KEY=""
EMAIL_FROM="CU Esports Club <admin@cuec.club>"
SITE_URL=http://localhost:3000
